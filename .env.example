# Copy to .env and adjust. All variables are optional (defaults shown).
VA_WHISPER_MODEL=base.en
VA_WHISPER_DEVICE=cpu
VA_WHISPER_COMPUTE_TYPE=int8
VA_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VA_LLM_MAX_NEW_TOKENS=120
VA_PIPER_VOICE=en_US-lessac-medium
VA_PIPER_MODEL_DIR=models/piper

# Hugging Face downloads behind a proxy / mirror (uncomment if needed):
# HTTPS_PROXY=http://127.0.0.1:8080
# HF_ENDPOINT=https://hf-mirror.com
